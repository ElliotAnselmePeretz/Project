# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# In production set this to your deployed origin, e.g. https://deadlines.vercel.app
AUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (Azure app registration) --- OPTIONAL ---
# Leave these blank and the app runs in local mode: no sign-in, ManageBac only.
# Fill them in and real per-user Microsoft sign-in turns on by itself.
# See README for the registration steps.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Your school tenant ID, or "common" for any account type.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="common"

# --- Database ---
# Local dev: a file. Production: a Turso URL (libsql://...)
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""

# --- Encryption for stored ManageBac feed URLs ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
